# Keep the build context small and free of local state and secrets.
.git
**/node_modules
**/dist
!web/admin/dist/.keep
!themes/*/dist/.keep
# Sample challenge downloads are embedded in the binary.
!challenges/sample/*/dist
bin
data
data.bak-*
design
e2e/test-results
e2e/playwright-report
coverage.out
flagfall.toml
.env
*.exe
.idea
.vscode
