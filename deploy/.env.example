# Copy to .env next to docker-compose.yml and fill in.

# The public name players open, with DNS pointing at this server.
FLAGFALL_DOMAIN=ctf.example.org
# A long random password for the database (only Flagfall uses it).
POSTGRES_PASSWORD=

# Optional: pin a release instead of latest, e.g. ghcr.io/flagfall/flagfall:1.0.0
# FLAGFALL_IMAGE=ghcr.io/flagfall/flagfall:latest
